  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.3.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "mockgoose": "^8.0.4",
    "mongodb-memory-server": "^9.5.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
